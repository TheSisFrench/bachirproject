<footer>
    <a class="return-up-button" href="#nav" onclick="returnUp()"> <!-- Changed href to #nav to match your nav container ID -->
        <svg class="up-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 14L12 8L18 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>                
        <span class="return-up-button-tooltip">
            <%= t('return_up_button_tooltip') %>
        </span>
    </a>

    <div class="footer-container">
        <section class="contact-footer">
            <div class="contact-footer-container">
                <h1 class="contact-footer-header">
                    <%= t('footer_heading') %>
                </h1>
                <div class="contact-footer-padding-indentation">
                    <div class="enter-name-container">
                        <input class="enter-name" type="text" id="name" placeholder="<%= t('contact_form_name_placeholder', {defaultValue: 'Name'}) %>" name="name" required>
                    </div>
                    <div class="enter-message-container">
                        <textarea class="enter-message" id="message" name="message" placeholder="<%= t('contact_form_message_placeholder', {defaultValue: 'Message for the artist'}) %>" maxlength="1500" required></textarea>
                    </div>
                </div>
                <div class="send-message-button-container">
                    <button class="send-message-button" id="sendEmailBtn" type="button">
                        <p class="send-message">
                            <%= t('send_message_button_message') %>
                        </p>
                    </button>
                </div>
            </div>            
        </section>
      
        <section class="footer-link">
            <div class="footer-link-indent">
                <div class="footer-link-container">
                    <ul class="website-sections">
                        <li class="menu-selection-footer">
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-link" href="<%= basePathWithLang %>/gallery">
                                    <%= t('web_section_gallery') %>
                                </a>
                            </div>
                            <!-- This sub-list is already correct and dynamic -->
                            <% if (navigation && navigation.collections && navigation.collections.length > 0) { %>
                                <% navigation.collections.forEach(collection => { %>
                                    <div>
                                        <a class="menu-selection-footer-sublink" href="<%= collection.path %>">
                                            <%= collection.title %>
                                        </a>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <li class="gallery-selection">
                                    <span class="nav-menu-link-header"><%= t('no_collections_available', { defaultValue: 'No collections available' }) %></span>
                                </li>
                            <% } %>
                        </li>

                        <li class="menu-selection-footer">
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-link" href="<%= basePathWithLang %>/about">
                                    <%= t('web_section_about') %>
                                </a>
                            </div>
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-sublink" href="<%= basePathWithLang %>/about#presentation">
                                    <%= t('web_section_about_presentation') %>
                                </a>
                            </div>
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-sublink" href="<%= basePathWithLang %>/about#vision">
                                    <%= t('web_section_about_the_vision') %>
                                </a>
                            </div>
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-sublink" href="<%= basePathWithLang %>/about#achievements">
                                    <%= t('web_section_about_realisations') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-link" href="<%= basePathWithLang %>/exhibitions">
                                    <%= t('web_section_exhibitions') %>
                                </a>
                            </div>
                            <div>
                                <!-- CORRECTED LINK & KEY -->
                                <a class="menu-selection-footer-sublink" href="<%= basePathWithLang %>/exhibitions#past-exhibitions">
                                    <%= t('web_section_exhibitions_past_exhibitions') %>
                                </a>
                            </div>
                            <div>
                                <!-- CORRECTED LINK & KEY -->
                                <a class="menu-selection-footer-sublink" href="<%= basePathWithLang %>/exhibitions#new-exhibitions">
                                    <%= t('web_section_exhibitions_new_exhibitions') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-link" href="<%= basePathWithLang %>/contact">
                                    <%= t('web_section_contact') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <!-- CORRECTED LINK -->
                                <a class="menu-selection-footer-link" href="<%= basePathWithLang %>/store">
                                    <%= t('web_section_store') %>
                                </a>
                            </div>
                        </li>
                    </ul>
                    <div class="media">
                        <!-- Media links should probably be absolute external links -->
                        <a href="https://facebook.com/your-profile" target="_blank" rel="noopener noreferrer"><img class="facebook media-icon" src="/img/icons8-facebook.svg"></a>
                        <a href="https://instagram.com/your-profile" target="_blank" rel="noopener noreferrer"><img class="linkedin media-icon" src="/img/icons8-instagram.svg"></a>
                        <a href="https://linkedin.com/in/your-profile" target="_blank" rel="noopener noreferrer"><img class="instagram media-icon" src="/img/icons8-linkedin.svg"></a>
                        <a href="https://x.com/your-profile" target="_blank" rel="noopener noreferrer"><img class="x media-icon" src="/img/icon_X.svg"></a>
                    </div>  
                    <div class="credits">
                        <div class="copyrights">
                            <%= t('copyright') %>
                        </div>
                    </div>  
                </div>
            </div>
        </section>
    </div>
</footer>