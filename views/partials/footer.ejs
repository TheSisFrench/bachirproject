
<footer>

    <a class="return-up-button" href="#nav-header" onclick="returnUp()">
        <svg class="up-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 14L12 8L18 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>                
        <span class="return-up-button-tooltip">Haut de page</span>
    </a>

    <div class="footer-container">

        <section class="contact-footer">

            <div class="contact-footer-container">
                <h1 class="contact-footer-header">
                    <%= t('footer-heading') %>
                </h1>

                <div class="contact-footer-padding-indentation">
                    <div class="enter-name-container">
                        <input class="enter-name" type="text" id="name" placeholder="Nom" name="name" required>
                    </div>

                    <div class="enter-message-container">
                        <textarea class="enter-message" id="message" name="message" placeholder="Message pour l'artiste" maxlength="1500" required></textarea>
                    </div>
                </div>
                
                <div class="send-message-button-container">
                    <button class="send-message-button" id="sendEmailBtn" type="button">
                        <p class="send-message">
                            <%= t('send-message-button-message') %>
                        </p>
                    </button>
                </div>
            </div>            
                

        </section>
      

        <section class="footer-link">
            <div class="footer-link-indent">
                <div class="footer-link-container">
                    <ul class="website-sections">
                        <li class="menu-selection-footer">
                            <div>
                                <a class="menu-selection-footer-link" href="/gallery">
                                    <%= t('web-section-gallery') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/new-collection">
                                    <%= t('gallery-new-collection') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/family">
                                    <%= t('gallery-family-collection') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/special-edition">
                                    <%= t('gallery-special-edition') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/mor-talla">
                                    <%= t('gallery-mor-talla') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="black-collection">
                                    <%= t('gallery-black-collection') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <a class="menu-selection-footer-link" href="/about">
                                    <%= t('web-section-about') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/about#presentation">
                                    <%= t('web-section-about-presentation') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/about#vision">
                                    <%= t('web-section-about-the-vision') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/about#achievements">
                                    <%= t('web-section-about-realisations') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <a class="menu-selection-footer-link" href="/exhibitions">
                                    <%= web-section-exhibitions %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/exhibitions#past-exhibitions">
                                    <%= t('web-section-exhibitions-new-exhibitions') %>
                                </a>
                            </div>
                            <div>
                                <a class="menu-selection-footer-sublink" href="/exhibitions#new-exhibitions">
                                    <%= t('web-section-exhibitions-past-exhibitions') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <a class="menu-selection-footer-link" href="/contact">
                                    <%= t('web-section-contact') %>
                                </a>
                            </div>
                        </li>
                        <li class="menu-selection-footer">
                            <div>
                                <a class="menu-selection-footer-link" href="/store">
                                    <%= t('web-section-store') %>
                                </a>
                            </div>
                        </li>
                    </ul>
                    <div class="media">
                        <img class="facebook media-icon" src="/img/icons8-facebook.svg">
                        <img class="linkedin media-icon" src="/img/icons8-instagram.svg">
                        <img class="instagram media-icon" src="/img/icons8-linkedin.svg">
                        <img class="x media-icon" src="/img/icon_X.svg">
                    </div>  
                    <div class="credits">
                        <div class="copyrights">Copyright &#64;2025 BachirProject.com - All rights reserved.</div>
                    </div>  
                </div>
            </div>
            
        </section>
        
    </div>
</footer>
