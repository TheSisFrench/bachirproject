<main>
    <div class="">
        <section class="contact-footer">
            <div class="contact-footer-container">
                <h1 class="contact-footer-header">
                    <%= t('footer_heading') %>
                </h1>
                <div class="contact-footer-padding-indentation">
                    <div class="enter-name-container">
                        <input class="enter-name" type="text" id="name" placeholder="<%= t('contact_form_name_placeholder', {defaultValue: 'Name'}) %>" name="name" required>
                    </div>
                    <div class="enter-message-container">
                        <textarea class="enter-message" id="message" name="message" placeholder="<%= t('contact_form_message_placeholder', {defaultValue: 'Message for the artist'}) %>" maxlength="1500" required></textarea>
                    </div>
                </div>
                <div class="send-message-button-container">
                    <button class="send-message-button" id="sendEmailBtn" type="button">
                        <p class="send-message">
                            <%= t('send_message_button_message') %>
                        </p>
                    </button>
                </div>
            </div>            
        </section>
    </div>
</main>