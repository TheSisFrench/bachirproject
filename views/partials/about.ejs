
<main>
    <header class="about-main-header">
        <div class="about-title-container">
            <div class="about-title">
                <span class="about-sub-title"><%= t('about_page_sub_main_heading') %></span>
                <span class="about-page-title"><%= t('about_page_main_heading') %></span>
            </div>
        </div>
    </header>

    

    <section class="about-first-section">
        <div class="about-first-section-container" id="presentation">

            <div class="origin-inspiration-container">
                <div class="about-origin-section-container">
                    <h3><span class="bold"><%= t('about_page_origins_heading') %></span></h3>
                    <p class="presentation-text"><span class="bold">El Bachir</span> <%= t('about_page_origins_text') %> <span class="bold"><%= t('about_page_origins_text_bold') %></span></p> 

                    <br/>

                    <p class="presentation-text"><%= t('about_page_origins_text_sequel') %></p>
                </div>

                <div class="about-inspiration-section-container">
                    <h3><span class="bold"><%= t('about_page_inspirations_heading') %></span></h3>
                    <p class="presentation-text"><%= t('about_page_inspiration_text') %> <span class="bold"><%= t('about_page_inspiration_text_bold') %></span> <%= t('about_page_inspiration_text_sequel') %></p> 
                </div>  
            </div>
            
            
        </div>
    </section>

    <section class="second-section">
        <div class="scroll-movie-container">
            <div class="frame-viewer"></div>
        </div> 
    </section>

    <section class="about-third-section"> 
        <div class="about-third-section-container">
            <div class="senegal-container" id="the-vision">
                <div class="senegal-text-section">
                    <p class="senegal">Sunuu</p>
                </div>

                <div class="senegal-text-section">
                    <p class="senegal">gaal</p>
                </div>

                <div class="senegal-explanation left-curly-bracket">
                    <p><%= t('about_page_sunuugaal_first_section') %></p>
                </div>
                <div class="senegal-explanation right-curly-bracket">
                    
                    <p><%= t('about_page_sunuugaal_second_section') %></p>
                </div>

                
            </div>
            <div class="senegal-text-explanation-container">
                <p class="senegal-text-explanation">
                    <%= t('about_page_bachir_world_begin') %>
                </p>
            </div>
        </div>
    </section>

    <section class="about-fourth-section">
        <div class="about-fourth-section-container">
            <div class="realizations-heading-container">
                <p class="realizations-heading">
                    <%= t('about_page_realizations_heading') %>
                </p>
            </div>
            <div class="realizations-list">
                <div class="realization-container">
                    <h3 class="realization">
                        <%= t('about_page_realizations-first-realization') %>
                    </h3>
                    <p class="realization-description">
                        <%= t('about_page_realizations_first_realization_description') %>
                    </p>
                </div>
                
                <div class="realization-container">
                    <h3 class="realization">
                        <%= t('about_page_realizations_second_realization') %>
                    </h3>
                    <p class="realization-description">
                        <%= t('about_page_realizations_second_realization_description') %>
                    </p>
                </div>
                
            </div>
            
        </div>
    </section>

    <section id="about-last-section">
        <div class="last-section-container">

            <div class="last-section-intro-container">
                <div class="slides-discover-artist-container">
                    
                    
                    
                    <a class="slide donation-slide" href="/donation">
                        <span>Faire un don</span>
                    </a>
                    <a class="slide store-slide" href="/store">
                        <span>Boutique</span>
                    </a>                          
                </div>
            </div>
        </div>
    </section>
</main>
