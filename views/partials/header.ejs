    <div class="language-switcher">
    <% const otherLang = currentLanguage === 'en' ? 'fr' : 'en'; %>
    <% const otherLangText = currentLanguage === 'en' ? 'Français' : 'English'; %>
    <%
        // These variables (currentLanguage, originalPathWithoutLang, queryParamsString)
        // should be available from res.locals, set by your pathLanguageHandler.js

        // Construct the new base path with the OTHER language
        const newPath = `/${otherLang}${originalPathWithoutLang}`;

        // Append the original query string (which is already a string like "?foo=bar" or "")
        const newHref = `${newPath}${queryParamsString}`;
    %>
      <a class="language-switcher-button-container" href="<%= newHref %>">
        <p class="language-switcher-button">
            <%= otherLangText %>
        </p>
      </a>
    </div>

    <button class="hamburger-button" id="hamburgerButton" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="hamburger-icon" viewBox="0 0 100 80" width="30" height="30">
        <rect class="line line1" width="100" height="15" rx="8"></rect>
        <rect class="line line2" y="30" width="100" height="15" rx="8"></rect>
        <rect class="line line3" y="60" width="100" height="15" rx="8"></rect>
      </svg>
    </button>
