<!DOCTYPE html>
<html lang="<%= currentLanguage %>">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <link rel="stylesheet" href="/css/style.css">
        <link rel="stylesheet" href="/css/reset_Style.css">
        <link rel="stylesheet" href="/css/variables.css">
        <link rel="stylesheet" href="/css/header.css">
        <link rel="stylesheet" href="/css/footer.css">
        <link rel="stylesheet" href="/css/home.css">
        <link rel="stylesheet" href="/css/gallery.css">
        <link rel="stylesheet" href="/css/exhibitions.css">
        <link rel="stylesheet" href="/css/about.css">
        <link rel="stylesheet" href="/css/contact.css">
        <link rel="stylesheet" href="/css/store.css">

        <title><%= title %></title>
    </head>

    <!-- views/index.ejs (More Explicit Version) -->

    <body data-page-id="<%= typeof pageIdentifier !== 'undefined' ? pageIdentifier : '' %>">
        <%# Explicitly pass all data the header needs %>
        <%- include('./partials/header', {
            currentPage: currentPage,
            currentLanguage: currentLanguage,
            basePathWithLang: basePathWithLang,
            originalPathWithoutLang: originalPathWithoutLang,
            queryParamsString: queryParamsString,
            t: t, // Pass the 't' function
            navigation: navigation // Pass the navigation object
        }) %>

        
        <% if (bodyPartialName) { %>
            <%# Explicitly pass all data the body partial might need %>
            <%- include('./partials/' + bodyPartialName, {
                heading: heading,
                collections: (typeof collections !== 'undefined' ? collections : []),
                collection: (typeof collection !== 'undefined' ? collection : null),
                t: t,
                navigation: navigation,
                currentLanguage: currentLanguage
            }) %>
        <% } else { %>
            <p>Error: No content partial specified.</p>
        <% } %>


        <%# Footer also needs access to navigation data and 't' %>
        <%- include('./partials/footer', { t: t, navigation: navigation, basePathWithLang: basePathWithLang }) %>

        <script src="/index.js"></script>
    </body>

</html>